{
  "sourceSha256": "8dd3c1d095fa723a06e03d14d36f245c2847e2446a4ff315b03f1921d0e70804",
  "wrapPositives": [
    {
      "id": "aki-history-post-strep",
      "pdfPage": 93,
      "expectedText": "1) History/exam: review vitals for HTN/HoTN, volume status, exposures (contrast, meds), recent infection (IgA nephropathy 1-2d, post-strep GN in 10-14d), active infection (sepsis can induce ATN independent of BP or ↓RBF (JASN2011;22:999)), trauma/myalgias/found down (rhabdomyolysis), rashes (AIN, vasculitis)",
      "type": "list-item"
    },
    {
      "id": "aki-fena-symbol-metric",
      "pdfPage": 93,
      "expectedText": "◦ FENa: FENa <1% c/w pre-renal AKI, >2% c/w ATN. ONLY verified in oliguric AKI, not useful if on diuretics or after IVF. Interpret with caution in baseline CKD or chronic prerenal disease (CHF/cirrhosis). GN, rhabdo, & IV contrast can all cause FENa <1%. Overall limited use in hospital setting, except to rule out HRS with ↑FeNa (JHospMed2016;11:77)",
      "type": "list-item"
    },
    {
      "id": "aki-urine-protein-symbol-metric",
      "pdfPage": 93,
      "expectedText": "◦ Urine protein: if proteinuria on UA, send serum albumin, urine total protein, urine microalbumin, & urine Cr. Urine albumin/protein ratio (APR) >0.4 suggests glomerular > tubulointerstitial process (Sn 88%, Sp 99%) (NephroDialTrans2012;27:1534).",
      "type": "list-item"
    },
    {
      "id": "ttm-flush-left-wrap",
      "pdfPage": 5,
      "expectedText": "- Stepwise approach to shivering in pts undergoing TTM (1st line: PR/PO acetaminophen 650q6 → IV, Mg >3, 2nd line: skin counterwarming + dexmedetomidine OR propofol OR hydromorphone boluses, 3rd line: propofol + hydromorphone gtt, consider buspirone 30q8, 4th line: NMBA) (Neurocrit Care 2011;14:389)",
      "type": "list-item"
    },
    {
      "id": "chest-pain-low-intermediate",
      "pdfPage": 16,
      "expectedText": "- Stress test: r/o ACS if low-intermediate risk",
      "type": "list-item"
    },
    {
      "id": "cta-moderate-risk-label-like-wrap",
      "pdfPage": 23,
      "expectedText": "◦ Asymptomatic pts: NOT for screening use. Low-risk pts with sx: high NPV (99%) for CAD rule-out (JACC2008;52:1724). Moderate-risk pts with sx: reasonable for risk stratification (especially after equivocal stress test).",
      "type": "list-item"
    },
    {
      "id": "low-flow-as-label-like-wrap",
      "pdfPage": 32,
      "expectedText": "◦ Low-flow/low-gradient AS: severity underestimated in reduced EF as ↓ flow →↓ gradient. Subsets distinguished by flow (low-flow: SVi <35 mL/m2), gradient (low-gradient: <40mmHg), LVEF, and dobutamine stress TTE (DSE) (Circ 2011;124:739)",
      "type": "list-item"
    },
    {
      "id": "vte-nonmodifiable",
      "pdfPage": 51,
      "expectedText": "- indefinite: low bleeding risk AND non provoked, active cancer, other non-modifiable risk factors (IBD, nephrotic syndrome, etc.)",
      "type": "list-item"
    },
    {
      "id": "ph-tte-flush-left",
      "pdfPage": 52,
      "expectedText": "- TTE (w/ agitated bubble): eval for left HF and shunt (& whether severity explains PH); ↑ RVSP may suggest PH but is not sufficient to diagnose/categorize",
      "type": "list-item"
    },
    {
      "id": "ph-cpet-flush-left",
      "pdfPage": 52,
      "expectedText": "- CPET: determine etiology of exercise intolerance (cardiac vs pulmonary/PAH vs other)",
      "type": "list-item"
    },
    {
      "id": "abdominal-liver-list-wrap",
      "pdfPage": 68,
      "expectedText": "• Liver pathologies (hepatitis, abscess, Budd-Chiari, portal vein thrombus, Fitz-Hugh-Curtis)",
      "type": "list-item"
    },
    {
      "id": "abdominal-biliary-list-wrap",
      "pdfPage": 68,
      "expectedText": "• Biliary pathologies (cholelithiasis/biliary colic, cholecystitis, cholangitis, Sphincter of Oddi dysfunction)",
      "type": "list-item"
    }
  ],
  "boundaryNegatives": [
    {
      "id": "primary-secondary-ai",
      "pdfPage": 177,
      "leftText": "Primary AI (Addison’s disease): ↓all adrenal hormones → ↑ACTH. Lesion localizes to bilateral adrenal glands",
      "rightText": "Secondary AI: ↓ACTH → ↓adrenal hormone (glucocorticoids only). Lesion localizes to pituitary gland or hypothalamus"
    },
    {
      "id": "primary-secondary-symptom-groups",
      "pdfPage": 177,
      "leftText": "Primary only (↓serum aldo): hyperK (only 65%), salt craving, hyperpigmentation (↑MSH), n/v, abdominal pain, ↓BP, ↑HR, shock",
      "rightText": "Secondary only (RAAS intact): ± hypopituitarism, hypoglycemia (more common than in primary AI)"
    },
    {
      "id": "aki-next-numbered-step",
      "pdfPage": 93,
      "leftText": "1) History/exam: review vitals for HTN/HoTN, volume status, exposures (contrast, meds), recent infection (IgA nephropathy 1-2d, post-",
      "rightText": "2) Urinalysis (UA): see Urinalysis. If AKI and UA demonstrate unexplained blood and protein, consider GN and renal c/s."
    },
    {
      "id": "aki-fena-feurea",
      "pdfPage": 93,
      "leftText": "◦ FENa: FENa <1% c/w pre-renal AKI, >2% c/w ATN. ONLY verified in oliguric AKI, not useful if on diuretics or after IVF. Interpret",
      "rightText": "◦ FEUrea: if on diuretics and high pretest prob. of pre-renal physiology. FEUrea <35% c/w with pre-renal (KidInt2002;62:2223)"
    },
    {
      "id": "hhs-new-labels",
      "pdfPage": 176,
      "leftText": "Pathophysiology: hyperglycemia → osmotic diuresis → volume depletion; ketogenesis suppressed by low (but present) insulin levels",
      "rightText": "Precipitants: same as DKA (note: pts w/ T2DM and burnt-out pancreas can also present with DKA)"
    },
    {
      "id": "procedural-new-steps",
      "pdfPage": 253,
      "leftText": "Catheter selection: select based on number of lumens and speed of infusion; if rapid infusion required → large bore, short length (Cordis/MAC). Right IJ catheter length: 16cm. Left IJ catheter length: 20cm",
      "rightText": "Infection control: scheduled exchange of catheters without evidence of infection is NOT indicated. Cultures drawn from indwelling catheters have ↑false ⊕ rate; generally not done aside from time of sterile placement (NEJM 2003;348:1123)"
    }
  ],
